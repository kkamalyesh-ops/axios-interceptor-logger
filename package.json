{
  "name": "axios-interceptor-logger",
  "version": "1.1.0",
  "description": "Axios Unified HTTP Transaction Logger",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --minify",
    "test": "NODE_OPTIONS='--max-old-space-size=16' node --import tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "axios",
    "interceptor",
    "logger",
    "packetbeat",
    "ecs",
    "elastic",
    "logging"
  ],
  "author": "Kamalyesh Kannadkar <k.kamalyesh@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkamalyesh-ops/axios-interceptor-logger.git"
  },
  "bugs": {
    "url": "https://github.com/kkamalyesh-ops/axios-interceptor-logger/issues"
  },
  "homepage": "https://github.com/kkamalyesh-ops/axios-interceptor-logger#readme",
  "peerDependencies": {
    "axios": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "axios": "^1.6.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
